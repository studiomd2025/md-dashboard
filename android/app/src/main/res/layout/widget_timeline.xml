<?xml version="1.0" encoding="utf-8"?>
<!--
  Timeline Widget Layout
  Hosts a ListView that is populated via RemoteViewsService (WidgetTimelineService).
  The root background colour is set at runtime by the provider.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/widget_bg_gray">

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_timeline_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_timeline_name"
            android:textColor="@color/widget_ink_gray"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/widget_timeline_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_rotate"
            android:background="@null"
            android:contentDescription="@string/widget_tap_refresh" />
    </LinearLayout>

    <!-- Divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_divider" />

    <!-- Post list (populated by WidgetTimelineService) -->
    <ListView
        android:id="@+id/widget_timeline_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <!-- Empty / error state (shown via visibility toggling at runtime) -->
    <TextView
        android:id="@+id/widget_timeline_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_timeline_empty"
        android:textColor="@color/widget_subtext_gray"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Timestamp -->
    <TextView
        android:id="@+id/widget_timeline_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:text=""
        android:textColor="@color/widget_subtext_gray"
        android:textSize="10sp" />
</LinearLayout>
