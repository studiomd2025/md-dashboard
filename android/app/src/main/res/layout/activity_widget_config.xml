<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared configuration activity layout used by widgets that need a setup step.
  Content above the Save button is populated programmatically per widget type.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/widget_white">

    <!-- Title -->
    <TextView
        android:id="@+id/config_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_configure"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/widget_ink_gray"
        android:layout_marginBottom="20dp" />

    <!-- Theme picker label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_theme_label"
        android:textSize="14sp"
        android:textColor="@color/widget_subtext_gray"
        android:layout_marginBottom="8dp" />

    <!-- Theme spinner -->
    <Spinner
        android:id="@+id/config_theme_spinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="20dp"
        android:background="@android:drawable/btn_dropdown" />

    <!-- Widget-specific extra content is inserted programmatically into this container -->
    <LinearLayout
        android:id="@+id/config_extra_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <!-- Save button -->
    <Button
        android:id="@+id/config_save_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_save"
        android:layout_marginTop="16dp" />
</LinearLayout>
