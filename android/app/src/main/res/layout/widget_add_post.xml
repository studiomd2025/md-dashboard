<?xml version="1.0" encoding="utf-8"?>
<!--
  Add Post Widget Layout.
  A large tap target that deep-links to the app's new-post composer.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="14dp"
    android:background="@color/widget_bg_gray">

    <!-- Plus icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✏️"
        android:textSize="28sp"
        android:gravity="center" />

    <!-- Primary CTA label -->
    <TextView
        android:id="@+id/widget_addpost_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_addpost_label"
        android:textColor="@color/widget_ink_gray"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_addpost_subtitle"
        android:textColor="@color/widget_subtext_gray"
        android:textSize="11sp"
        android:gravity="center" />

    <!-- Invisible full-cover tap target overlay — click handled on the root in provider -->
    <LinearLayout
        android:id="@+id/widget_addpost_tap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="invisible" />
</LinearLayout>
