<?xml version="1.0" encoding="utf-8"?>
<!--
  MD Countdown Widget Layout
  Centered large bold timer, horizontal centered 4x1 bar, and bottom-left title/tags for vertical expanded mode.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_countdown_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_countdown_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_surface_crisp"
        android:scaleType="fitXY"
        android:contentDescription="" />

    <LinearLayout
        android:id="@+id/widget_countdown_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Horizontal container for 4x1 Horizontal breakpoint (Timer centered across bar) -->
        <LinearLayout
            android:id="@+id/widget_countdown_horiz_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_countdown_horiz_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="D-Day"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="none"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false" />

            <Chronometer
                android:id="@+id/widget_countdown_horiz_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:countDown="true"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="none"
                android:includeFontPadding="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_countdown_horiz_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Next on MD"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textColor="#334155"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Vertical / Standard container (RelativeLayout with top centered Timer + bottom-left Title/Tags) -->
        <RelativeLayout
            android:id="@+id/widget_countdown_vert_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Top section: Centered Large Bold Timer -->
            <LinearLayout
                android:id="@+id/widget_countdown_top_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="2dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_countdown_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:text="D-Day"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:maxLines="2"
                    android:ellipsize="none"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false" />

                <Chronometer
                    android:id="@+id/widget_countdown_chronometer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:countDown="true"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="2"
                    android:ellipsize="none"
                    android:includeFontPadding="false"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Bottom section: Title + Hashtag pill anchored to bottom-left -->
            <LinearLayout
                android:id="@+id/widget_countdown_bottom_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:gravity="start"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_countdown_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="Next on MD"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textSize="13sp"
                    android:textColor="#334155" />

                <TextView
                    android:id="@+id/widget_countdown_tags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:gravity="start"
                    android:layout_marginTop="4dp"
                    android:text="#EventTag"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#1D4ED8"
                    android:background="@drawable/widget_hashtag_pill"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone" />
            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>
</FrameLayout>
