<?xml version="1.0" encoding="utf-8"?>
<!--
  MD Single Post Widget Layout
  Matches WIDGET_SPEC.md: auto-responsive, uncropped media, clean native styling
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_single_post_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_single_post_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_surface_crisp"
        android:scaleType="fitXY"
        android:contentDescription="" />

    <LinearLayout
        android:id="@+id/widget_single_post_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Post Title (if non-empty and not "Diary Entry") -->
        <TextView
            android:id="@+id/widget_single_post_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Latest Diary Post"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="visible" />

        <!-- Meta row: yyyy.m.d · #tag -->
        <TextView
            android:id="@+id/widget_single_post_timestamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="2026.11.25"
            android:textSize="10sp"
            android:textColor="#64748B"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Post excerpt / caption -->
        <TextView
            android:id="@+id/widget_single_post_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Select a post in widget settings"
            android:textSize="12sp"
            android:textColor="#1E293B"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- Uncropped image / GIF: adjustViewBounds="true", scaleType="fitCenter" -->
        <ImageView
            android:id="@+id/widget_single_post_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="Post media"
            android:visibility="gone" />

        <!-- Real placeholder / fallback when media is loading or unavailable -->
        <LinearLayout
            android:id="@+id/widget_single_post_image_placeholder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:minHeight="64dp"
            android:background="@drawable/widget_media_placeholder_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_single_post_placeholder_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_media_placeholder"
                android:contentDescription="" />

            <TextView
                android:id="@+id/widget_single_post_placeholder_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Loading image…"
                android:textSize="10sp"
                android:textColor="#64748B"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Divider above footer -->
        <ImageView
            android:id="@+id/widget_single_post_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:src="@drawable/widget_divider"
            android:scaleType="fitXY"
            android:contentDescription="" />

        <!-- Footer: "Open ↗" -->
        <TextView
            android:id="@+id/widget_single_post_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Open ↗"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#0284C7" />

    </LinearLayout>
</FrameLayout>
