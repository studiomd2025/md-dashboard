<?xml version="1.0" encoding="utf-8"?>
<!--
  Search Widget Layout.
  Tapping the input launches the app with a ?search= deep-link.
  The EditText is intentionally not focusable on the widget surface
  (RemoteViews restrictions) — tapping launches the app search screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="14dp"
    android:background="@color/widget_bg_gray">

    <!-- Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_search_name"
        android:textColor="@color/widget_accent_gray"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="1" />

    <!-- Search bar mock (tappable) -->
    <LinearLayout
        android:id="@+id/widget_search_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/widget_white"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/widget_search_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="14sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/widget_search_hint_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_search_hint"
            android:textColor="@color/widget_subtext_gray"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Go button -->
        <TextView
            android:id="@+id/widget_search_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/widget_search_btn"
            android:textColor="@color/widget_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@color/widget_accent_gray" />
    </LinearLayout>

    <!-- Hint -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_open_app"
        android:textColor="@color/widget_subtext_gray"
        android:textSize="11sp"
        android:gravity="center"
        android:maxLines="1" />
</LinearLayout>
