{
  "entities": {
    "Post": {
      "title": "Post",
      "description": "A diary post, scheduled entry, or unpublished draft stored in Firestore.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 300 },
        "bodyHtml": { "type": "string", "maxLength": 200000 },
        "font": { "type": "string", "enum": ["sans", "serif", "mono", "hand"] },
        "manualTags": { "type": "array" },
        "inlineTags": { "type": "array" },
        "attachments": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "publishedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "scheduledFor": { "type": "string", "maxLength": 64 },
        "scheduledTimeZone": { "type": "string", "maxLength": 64 },
        "pinnedUntil": { "type": "string", "maxLength": 64 },
        "pinnedTimeZone": { "type": "string", "maxLength": 64 },
        "isDraft": { "type": "boolean" },
        "authorId": { "type": "string", "maxLength": 128 },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title",
        "bodyHtml",
        "font",
        "manualTags",
        "inlineTags",
        "attachments",
        "createdAt",
        "publishedAt",
        "isDraft",
        "authorId",
        "serverCreatedAt",
        "serverUpdatedAt"
      ]
    },
    "Banner": {
      "title": "Banner",
      "description": "A header banner or scheduled slideshow slide.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 1000 },
        "subtitleHtml": { "type": "string", "maxLength": 4000 },
        "imageUrl": { "type": "string", "maxLength": 2000 },
        "mode": { "type": "string", "enum": ["default", "slideshow", "window", "daily-hours"] },
        "startAt": { "type": "string", "maxLength": 64 },
        "endAt": { "type": "string", "maxLength": 64 },
        "dailyStartHour": { "type": "number" },
        "dailyEndHour": { "type": "number" },
        "timeZone": { "type": "string", "maxLength": 64 },
        "priority": { "type": "number" },
        "authorId": { "type": "string", "maxLength": 128 },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "subtitle", "imageUrl", "mode", "priority", "authorId", "serverUpdatedAt"]
    },
    "EventCountdown": {
      "title": "EventCountdown",
      "description": "A Next on MD countdown event with optional milestone content.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "targetAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "timeZone": { "type": "string", "maxLength": 64 },
        "tag": { "type": "string", "maxLength": 80 },
        "location": { "type": "string", "maxLength": 200 },
        "bodyHtml": { "type": "string", "maxLength": 100000 },
        "font": { "type": "string", "enum": ["sans", "serif", "mono", "hand"] },
        "displayFormat": { "type": "string", "enum": ["full", "days-only", "d-day", "compact", "date-only"] },
        "attachments": { "type": "array" },
        "milestoneBodyHtml": { "type": "string", "maxLength": 100000 },
        "milestoneFont": { "type": "string", "enum": ["sans", "serif", "mono", "hand"] },
        "milestoneAttachments": { "type": "array" },
        "authorId": { "type": "string", "maxLength": 128 },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "targetAt", "authorId", "serverUpdatedAt"]
    },
    "DesignConfig": {
      "title": "DesignConfig",
      "description": "Global dashboard theme, surface style, backdrop override, and custom user themes.",
      "type": "object",
      "properties": {
        "theme": { "type": "string", "maxLength": 128 },
        "surfaceStyle": { "type": "string", "enum": ["aero-glass", "crisp-2026"] },
        "customBackdropUrl": { "type": "string", "maxLength": 2000 },
        "customThemes": { "type": "array" },
        "authorId": { "type": "string", "maxLength": 128 },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["theme", "surfaceStyle", "customBackdropUrl", "customThemes", "authorId", "serverUpdatedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized dashboard administrator record.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 254 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "Collaborator": {
      "title": "Collaborator",
      "description": "Google account authorized from within the website to co-manage the shared timeline.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 254 },
        "displayName": { "type": "string", "maxLength": 160 },
        "note": { "type": "string", "maxLength": 500 },
        "addedByUid": { "type": "string", "maxLength": 128 },
        "addedByEmail": { "type": "string", "maxLength": 254 },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "addedByUid", "addedAt"]
    },
    "AccessRequest": {
      "title": "AccessRequest",
      "description": "Self-registration request submitted by a signed-in Google user to join the shared timeline.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 254 },
        "displayName": { "type": "string", "maxLength": 160 },
        "note": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending"] },
        "requestedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "status", "requestedAt"]
    },
    "PlayEvent": {
      "title": "PlayEvent",
      "description": "Custom YouTube playlist or video added to Play Event in Live TV.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "url": { "type": "string", "maxLength": 2000 },
        "kind": { "type": "string", "enum": ["youtube-playlist", "youtube-video"] },
        "mediaId": { "type": "string", "maxLength": 200 },
        "dateLabel": { "type": "string", "maxLength": 64 },
        "year": { "type": "string", "maxLength": 32 },
        "era": { "type": "string", "maxLength": 80 },
        "scheduledFor": { "type": "string", "maxLength": 64 },
        "scheduledTimeZone": { "type": "string", "maxLength": 64 },
        "isDeleted": { "type": "boolean" },
        "authorId": { "type": "string", "maxLength": 128 },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "url", "kind", "mediaId", "dateLabel", "year", "era", "authorId", "serverUpdatedAt"]
    }
  },
  "firestore": {
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Diary posts, scheduled posts, and private drafts."
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Scheduled header banners and slideshow items."
    },
    "/countdowns/{countdownId}": {
      "schema": { "$ref": "#/entities/EventCountdown" },
      "description": "Next on MD upcoming event countdowns."
    },
    "/play_events/{eventId}": {
      "schema": { "$ref": "#/entities/PlayEvent" },
      "description": "Custom playlists added to Play Event directory in Live TV."
    },
    "/config/{configId}": {
      "schema": { "$ref": "#/entities/DesignConfig" },
      "description": "Theme and visual design configuration (document id: design)."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized dashboard owner accounts."
    },
    "/collaborators/{emailId}": {
      "schema": { "$ref": "#/entities/Collaborator" },
      "description": "Dynamically registered co-managers authorized to edit the shared timeline."
    },
    "/access_requests/{uid}": {
      "schema": { "$ref": "#/entities/AccessRequest" },
      "description": "Pending registration requests submitted from the website."
    }
  }
}
